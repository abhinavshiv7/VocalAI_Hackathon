APP_ENV=development
DATABASE_URL=postgresql+psycopg://sentinelloop:sentinelloop@postgres:5432/sentinelloop
FRONTEND_ORIGIN=http://localhost:3000
AUTHORIZED_TARGET_HOST=fake-target
AUTHORIZED_TARGET_PORT=3000
AUTHORIZED_TARGET_URL=http://fake-target:3000

# deterministic is offline and repeatable; live calls two independently configured roles.
AI_MODE=deterministic
INVESTIGATOR_BASE_URL=https://api.openai.com/v1
INVESTIGATOR_API_KEY=
INVESTIGATOR_MODEL=gpt-5-mini
CRITIC_BASE_URL=https://api.openai.com/v1
CRITIC_API_KEY=
CRITIC_MODEL=gpt-5-mini

MODEL_TIMEOUT_SECONDS=10
TOOL_TIMEOUT_SECONDS=10
MAX_INVESTIGATOR_CALLS=8
MAX_CRITIC_CALLS=5
MAX_TOOL_CALLS=10
DEBUG_FAILURES_ENABLED=true
