APP_ENV=development
DATABASE_URL=postgresql+psycopg://sentinelloop:sentinelloop@postgres:5432/sentinelloop
FRONTEND_ORIGIN=http://localhost:3000
# Baked into the browser bundle during the frontend image build. Set this to the
# public backend URL when deploying away from localhost, e.g. http://VM_IP:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTHORIZED_TARGET_HOST=fake-target
AUTHORIZED_TARGET_PORT=3000
AUTHORIZED_TARGET_URL=http://fake-target:3000
# Comma-separated lab hosts that an administrator permits users to register.
AUTHORIZED_TARGET_HOSTS=fake-target
# "attested" supports self-service target onboarding with a recorded user attestation.
# Set to "allowlisted" for administrator-managed environments.
TARGET_REGISTRATION_MODE=attested

# deterministic is offline and repeatable; live calls two independently configured roles.
AI_MODE=deterministic
INVESTIGATOR_BASE_URL=https://api.openai.com/v1
INVESTIGATOR_API_KEY=
INVESTIGATOR_MODEL=gpt-5-mini
CRITIC_BASE_URL=https://api.openai.com/v1
CRITIC_API_KEY=
CRITIC_MODEL=gpt-5-mini

MODEL_TIMEOUT_SECONDS=45
MODEL_RETRY_ATTEMPTS=3
MODEL_RETRY_MAX_DELAY_SECONDS=8
TOOL_TIMEOUT_SECONDS=10
MAX_INVESTIGATOR_CALLS=8
MAX_CRITIC_CALLS=5
MAX_TOOL_CALLS=10
DEBUG_FAILURES_ENABLED=true
